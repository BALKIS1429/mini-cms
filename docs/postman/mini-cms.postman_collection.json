{
  "info": {
    "_postman_id": "5b1f0a52-3f5e-4b5f-9a3d-6c2f9e0a14d7",
    "name": "Mini-CMS API",
    "description": "Collection de l'API de Mini-CMS : connexion, lecture des articles, création et déconnexion. Le jeton est enregistre automatiquement par la requete Connexion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Connexion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Enregistre le jeton renvoye dans la variable de collection token."
      }
    },
    {
      "name": "Articles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/posts?per_page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "posts"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "Creer un article",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Article cree depuis la collection\",\n    \"slug\": \"article-cree-depuis-la-collection\",\n    \"excerpt\": \"Cree avec le jeton enregistre par Connexion.\",\n    \"body\": \"Le contenu complet de cet article, envoye en JSON depuis Postman.\",\n    \"is_published\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/posts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        },
        "description": "Changez le slug du corps avant de relancer la requete."
      }
    },
    {
      "name": "Deconnexion",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
